model WorkspaceMemberRole {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceMemberId String    @map("workspace_member_id") @db.Uuid
  roleId            String    @map("role_id") @db.Uuid
  assignedBy        String?   @map("assigned_by") @db.Uuid
  assignedAt        DateTime  @default(now()) @map("assigned_at")
  expiresAt         DateTime? @map("expires_at")
  isPrimary         Boolean   @default(false) @map("is_primary")

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([workspaceMemberId, roleId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("workspace_member_role")
  @@schema("master")
}
