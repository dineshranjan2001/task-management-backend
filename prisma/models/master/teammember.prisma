model TeamMember {
  id                   String           @id @default(uuid()) @db.Uuid
  teamId               String           @map("team_id") @db.Uuid
  organizationMemberId String           @map("organization_member_id") @db.Uuid
  joinedAt             DateTime         @default(now()) @map("joined_at")
  leftAt               DateTime?
  isLead               Boolean          @default(false) @map("is_lead")
  status               MembershipStatus @default(ACTIVE)

  team               Team               @relation(fields: [teamId], references: [id])
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id])

  @@unique([teamId, organizationMemberId])
  @@index([organizationMemberId])
  @@index([teamId, status])
  @@map("team_member")
  @@schema("master")
}
